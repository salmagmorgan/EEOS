# Port the API (and, in production, the built web app) listens on
PORT=8787
# Database. Locally: a file path (created on first start).
# On Vercel: Postgres (postgres://…, e.g. Neon — its integration sets DATABASE_URL for you)
# or Turso (libsql://… plus DATABASE_AUTH_TOKEN; its integration sets TURSO_DATABASE_URL / TURSO_AUTH_TOKEN).
DATABASE_URL=./data/eeos.db
DATABASE_AUTH_TOKEN=
# Seed file loaded into an empty database on first start
SEED_PATH=./server/seed/demo-seed.json
# First admin account — created on first start if no users exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=EEOS Admin
# Mark session cookies Secure (automatic on Vercel; set true behind any other HTTPS host)
COOKIE_SECURE=false
# AI Copilot (optional). Without a key the Copilot page explains how to enable it.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5-5
# New-project emails (optional) — any SMTP account. Gmail / Google Workspace:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@company.com  SMTP_PASS=<16-letter app password>
# Microsoft 365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587 (SMTP AUTH must be allowed for the mailbox)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional display sender, e.g. "TBC EEOS <eeos@theboardconsulting.com>" (defaults to SMTP_USER)
EMAIL_FROM=
